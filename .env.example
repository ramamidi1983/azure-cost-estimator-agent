# Example environment configuration. Copy to `.env` and fill in your own values.
# NEVER commit a real `.env` (it is git-ignored). Do not put secrets in code.
#
# The Azure Retail Prices API used for pricing is PUBLIC and needs no key.
# All values below are OPTIONAL — the app runs without them (AI chat falls back
# to a deterministic rule-based parser when Azure OpenAI is not configured).

# ---- Azure OpenAI (optional; enables the AI inventory assistant) ----
# Your Azure OpenAI resource endpoint, e.g. https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# The name of YOUR model deployment (not the base model), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave AZURE_OPENAI_API_KEY BLANK to use Entra ID / managed identity (recommended).
# Only set a key if your resource has local auth enabled.
AZURE_OPENAI_API_KEY=

# ---- Optional persistence ----
# Directory for the inventory-reload cache and pricing cache. Point this at a
# mounted durable volume to survive container restarts; defaults to a temp dir.
PERSIST_DIR=
